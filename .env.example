# String de conexão do Postgres (ex: fornecida pelo Neon, Supabase ou Railway)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Chave da API da Anthropic — fica só no servidor, nunca é exposta ao navegador
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
